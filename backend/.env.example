PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/temple_billing
JWT_SECRET=your_jwt_secret_here

# PostgreSQL (Phase 1 — infrastructure only; MongoDB remains the source of truth)
# Provide either DATABASE_URL, or individual PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD values.
# PostgreSQL is enabled only when actual connection configuration (DATABASE_URL or PG* values) is present.
# POSTGRES_SSL alone does not enable PostgreSQL.
DATABASE_URL=postgresql://username:password@localhost:5432/temple_billing
# For hosted providers that require SSL, set POSTGRES_SSL=true (or pass ?sslmode=require in DATABASE_URL).
#POSTGRES_SSL=false
# Optional connection timeout in ms (default: 5000).
#PG_CONNECT_TIMEOUT_MS=5000

# Email configuration (Optional - falls back to mock or default gmail if not provided)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
